<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kerfur_memory</name>
  <version>0.0.0</version>
  <description>Context assembly and (later) memory store for Kerfur's cognition layer</description>
  <maintainer email="roo@todo.todo">roo</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>kerfur_msgs</depend>
  <depend>ament_index_python</depend>
  <!-- PyYAML for frontmatter parsing. rosdep key is python3-yaml. -->
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
